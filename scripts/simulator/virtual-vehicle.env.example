# Current same-host Demo gateway. Switch to https://DOMAIN after production TLS.
ROC_SERVER_URL=http://127.0.0.1:3000
ROC_DEVICE_TOKEN_FILE=/etc/roc-virtual-vehicle/vehicle-01.token
ROC_STATE_DIR=/var/lib/roc-virtual-vehicle/vehicle-01
ROC_ARTIFACT_DIR=/var/lib/roc-virtual-vehicle/vehicle-01/artifacts
ROC_LIBRARY_VERSION=python-simulator-0.1.0

ROC_TELEMETRY_INTERVAL_SECONDS=5
ROC_INITIAL_X=10.0
ROC_INITIAL_Y=10.0
ROC_INITIAL_THETA=0.0
ROC_LINEAR_VELOCITY=0.3
ROC_ANGULAR_VELOCITY=0.05
ROC_BATTERY_LEVEL=100

# Leave empty when using public trusted certificates. Never enable insecure TLS
# outside a controlled Demo environment.
ROC_TLS_CA_FILE=
ROC_TLS_INSECURE=false
ROC_MAX_ARTIFACT_BYTES=52428800
ROC_LOG_LEVEL=INFO
