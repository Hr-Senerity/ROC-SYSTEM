[Unit]
Description=ROC virtual vehicle %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/roc-virtual-vehicle/%i.env
ExecStart=/opt/roc-virtual-vehicle/.venv/bin/python /opt/roc-virtual-vehicle/virtual_vehicle.py
Restart=on-failure
RestartSec=5
User=roc-vehicle
Group=roc-vehicle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/roc-virtual-vehicle/%i
UMask=0077

[Install]
WantedBy=multi-user.target
