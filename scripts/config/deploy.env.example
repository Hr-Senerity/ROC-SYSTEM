# ROC-SYSTEM 部署配置（示例）
# 用法：
# 1) 复制本文件为 scripts/config/deploy.env
# 2) 如有敏感信息（密码/证书私钥路径等），放到 scripts/config/secrets.env（参考 secrets.env.example）
#
# 注意：
# - 所有 scripts/*.sh 都应只从 scripts/config/*.env 读取配置
# - 本文件可提交到仓库；deploy.env / secrets.env 不应提交

### 基础
ENV=dev
TZ=Asia/Shanghai

### 入口（宿主机 Nginx，不在 Docker 中）
# 域名（用于 Nginx server_name、证书申请等）
DOMAIN=example.com

# 部署后验收脚本使用的公开入口；Demo 可填写公网 IP + 映射端口。
PUBLIC_BASE_URL=http://127.0.0.1:3000

# TLS 模式：
# - off: 不启用 https（仅 80）
# - manual: 使用已有证书路径
# - letsencrypt: 用 certbot/letsencrypt 自动签发（后续由 gateway 脚本实现）
TLS_MODE=off
TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
LE_EMAIL=you@example.com

### 部署模式（每个模块独立）
# local: 本地部署（systemd/宿主机目录）
# docker: Docker 部署
FRONTEND_MODE=docker
BACKEND_MODE=docker
DB_MODE=docker

### 前端（Docker / 本地）
# 前端源码目录（相对仓库根目录）
FRONTEND_SOURCE_DIR=roc-frontend
# 前端构建输出目录（相对仓库根目录）
FRONTEND_BUILD_DIR=roc-frontend/build

# Docker 镜像与容器
FRONTEND_DOCKER_IMAGE=roc-frontend
FRONTEND_DOCKER_CONTAINER=roc-frontend

# 容器内部端口（前端镜像内通常是 Nginx:80）
FRONTEND_CONTAINER_PORT=80

# 宿主机映射端口（仅当你希望直接暴露前端容器时使用）
# 推荐生产用“宿主机 Nginx 入口”，前端容器可不映射公网端口，仅供本机/内网反代
FRONTEND_DOCKER_HOST_PORT=3000

# 前端容器的同源 /api 与 /ws 代理目标。留空时由 BACKEND_HOST/BACKEND_PORT 推导；
# 同机独立容器会自动把 127.0.0.1 转为 host.docker.internal。
# 分离主机可显式填写：http://<后端内网IP>:8080
FRONTEND_BACKEND_UPSTREAM=

# 本地部署时静态文件发布目录（宿主机 Nginx root 指向这里）
FRONTEND_LOCAL_PUBLISH_DIR=/var/www/roc-frontend

# 前端镜像构建位置
FRONTEND_DOCKERFILE=docker/frontend/Dockerfile
DOCKER_CONTEXT_PATH=.

### 后端（Docker / 本地）
BACKEND_DOCKER_IMAGE=roc-backend
BACKEND_DOCKER_CONTAINER=roc-backend

# 后端对外（给“宿主机 Nginx 网关”反代用）
# - 同机部署：127.0.0.1
# - 多服务器：填写后端服务器内网 IP
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# 后端容器内部监听端口（你后端实现时约定）
BACKEND_CONTAINER_PORT=8080

# 宿主机映射端口（用于宿主机 Nginx 反代，或调试）
BACKEND_DOCKER_HOST_PORT=8080

# 后端地图原图/制品持久卷。重建后端容器不会删除该卷。
BACKEND_MAP_VOLUME=roc_static

# 后端镜像构建位置（后续实现）
BACKEND_DOCKERFILE=docker/backend/Dockerfile

# 注意：DB_HOST 是“后端看到的数据库地址”
# - 后端在容器内 + DB 映射到宿主机端口：DB_HOST=172.17.0.1
# - 后端在宿主机本地运行：DB_HOST=127.0.0.1
# - DB 在另一台服务器：DB_HOST=<db内网IP或域名>
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=roc_db
DB_USER=roc_user

# DB_PASSWORD 放到 secrets.env
# PostgreSQL 原生 TLS。Demo/同机数据库可保持 disable；生产目标为 verify-full。
# require 仅加密但不验证服务器身份；verify-ca 校验证书链；verify-full 还校验 DB_HOST 主机名。
DB_SSLMODE=disable
# 以下为后端容器内路径。启用校验时，将对应文件放到 DB_SSL_CERT_DIR。
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=
# 宿主机只读证书目录；Docker 部署时挂载到 /run/secrets/roc-db。
# 示例：DB_SSL_CERT_DIR=/etc/roc-system/postgres-certs
DB_SSL_CERT_DIR=

# Postgres Docker
POSTGRES_DOCKER_IMAGE=roc-postgres
POSTGRES_DOCKER_CONTAINER=roc-postgres
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DOCKER_HOST_PORT=5432
POSTGRES_DOCKER_VOLUME=roc_postgres_data
POSTGRES_DOCKERFILE=docker/postgres/Dockerfile

### 其他（可选）
# 如果你希望脚本使用 sudo（Linux 服务器常见）
USE_SUDO=false

### 认证配置
JWT_SECRET=roc-system-default-secret-change-in-production
JWT_EXPIRE_SECONDS=86400
# 每辆车的 Device token 由平台车辆页生成，明文只返回一次，平台仅保存摘要。
# WebSocket Origin 白名单，逗号分隔；生产环境应填写实际前端来源，例如 https://roc.example.com
WS_ALLOWED_ORIGINS=
# 车辆心跳建议、断线判定和任务租约。以下为生产默认值；自动化测试可在隔离后端实例缩短。
DEVICE_HEARTBEAT_SECONDS=30
DEVICE_IDLE_TIMEOUT_SECONDS=45
TASK_LEASE_SECONDS=1800
# 地图文件仅由鉴权接口读取，不应放入前端或公网静态目录
MAP_STORAGE_DIR=/app/static/maps

### ============================================================
### 跨服务器分离部署场景
### ============================================================
# ROC-SYSTEM 支持前端/后端/数据库部署在不同服务器上:
#
# 场景 A — 单机部署 (docker-compose):
#   所有服务在同一宿主机，使用 docker/compose/docker-compose.yml
#   cd docker/compose && docker-compose up -d
#
# 场景 B — 前后端分离:
#   服务器A: 前端 (Nginx 静态服务)
#   服务器B: 后端 (C++ Drogon)
#   服务器C: 数据库 (PostgreSQL)
#
#   配置要点:
#   1. 前端服务器: FRONTEND_MODE=docker
#      需要知道后端地址 → 构建时设置 VITE_API_BASE_URL=http://<服务器B_IP>:8080
#   2. 后端服务器: BACKEND_MODE=docker
#      DB_HOST=<服务器C_IP>  (后端看到的数据库地址)
#   3. 网关服务器: deploy-gateway.sh
#      BACKEND_HOST=<服务器B_IP>  (Nginx反代到的后端地址)
#      FRONTEND_MODE=docker + FRONTEND_DOCKER_HOST_PORT=3000 (指向前端容器)
#
# 场景 C — 混合部署:
#   任意服务可选择 local 或 docker 模式，通过 *_MODE 变量控制

### 后端额外环境变量（传递给容器）
# 前端 API 地址（前端构建时需要）
VITE_API_BASE_URL=http://localhost:8080

