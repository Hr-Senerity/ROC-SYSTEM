# Docker Compose 环境变量
# 复制为 .env 并修改实际值

# 数据库
DB_USER=roc_user
DB_PASSWORD=change_me
DB_NAME=roc_db

# 后端
BACKEND_DOCKER_HOST_PORT=8080
JWT_SECRET=roc-system-default-secret-change-in-production
JWT_EXPIRE_SECONDS=86400

# 前端
FRONTEND_DOCKER_HOST_PORT=3000
# 前端容器构建时需要知道后端 API 地址
# 单机部署: http://localhost:BACKEND_DOCKER_HOST_PORT
# 分离部署: http://<后端服务器IP>:8080
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL 端口
POSTGRES_DOCKER_HOST_PORT=5432

# 后端构建镜像源: default (Ubuntu官方) / tsinghua (清华镜像)
APT_MIRROR=default
