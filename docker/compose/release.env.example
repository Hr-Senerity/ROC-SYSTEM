# 该文件随 release bundle 交付。复制为 release.env 后填写真实值。
# release.env 含口令，不要提交 Git，也不要回传到构建机。

# 构建脚本会在交付包中把占位符替换为实际版本。
ROC_RELEASE_VERSION=__ROC_RELEASE_VERSION__

DB_USER=roc_user
DB_PASSWORD=
DB_NAME=roc_db
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=

# 迁移现有环境时必须填写实际卷名。旧独立数据库脚本默认 roc_postgres_data，
# 旧 Compose 默认 roc_pgdata；请先在运行主机执行 docker volume ls 确认。
POSTGRES_DOCKER_VOLUME=roc_postgres_data
BACKEND_MAP_VOLUME=roc_static
# 默认防止因卷名写错而静默创建空数据库/空地图卷；全新安装才改为 false。
REQUIRE_EXISTING_DATA_VOLUMES=true

JWT_SECRET=
JWT_EXPIRE_SECONDS=86400
WS_ALLOWED_ORIGINS=
DEVICE_HEARTBEAT_SECONDS=30
DEVICE_IDLE_TIMEOUT_SECONDS=45
TASK_LEASE_SECONDS=1800

POSTGRES_DOCKER_HOST_PORT=5432
BACKEND_DOCKER_HOST_PORT=8080
FRONTEND_DOCKER_HOST_PORT=3000
