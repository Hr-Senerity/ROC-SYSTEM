{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roc.example/schemas/road-network-v2.schema.json",
  "title": "ROC semantic road network and deterministic trajectories v2",
  "description": "Canonical persisted and downlinked v2 topology plus SYSTEM-generated deterministic trajectories. Empty networks are valid drafts.",
  "x-roc-semantic-rules": {
    "inherits": "road-network-v1",
    "node_ids": "unique",
    "edge_ids": "unique",
    "edge_endpoints": "must reference existing nodes",
    "self_loops": "forbidden",
    "connections": "directed arcs must be unique; both reserves both directed arcs; opposite forward-only edges are allowed",
    "coordinates": "finite and not clipped by coordinate mode; coordinate_mode must equal the owning map",
    "empty_network": "allowed",
    "trajectories": "SYSTEM regenerates authoritative trajectories from sorted nodes and edges; one forward trajectory per edge and one reverse trajectory for each both edge",
    "samples": "indices are contiguous from zero; first and last points equal the directed edge endpoints; s is monotonic from zero; length equals final s",
    "input_trajectories": "not authoritative and replaced during normalization"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_mode", "sampling", "nodes", "edges", "trajectories"],
  "properties": {
    "schema_version": { "const": 2 },
    "coordinate_mode": { "enum": ["metric", "legacy-normalized"] },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "spacing", "precision"],
      "properties": {
        "algorithm": { "const": "uniform-parameter-v1" },
        "spacing": { "type": "number", "minimum": 0.000001, "maximum": 100 },
        "precision": { "const": 6 }
      }
    },
    "nodes": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/edge" } },
    "trajectories": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/trajectory" } }
  },
  "allOf": [
    {
      "if": { "properties": { "coordinate_mode": { "const": "legacy-normalized" } }, "required": ["coordinate_mode"] },
      "then": { "properties": { "sampling": { "properties": { "spacing": { "maximum": 1 } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
    "trajectoryId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "x", "y", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "x": { "type": "number" }, "y": { "type": "number" },
        "kind": { "const": "waypoint" }, "label": { "type": "string", "maxLength": 128 }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "const": "line" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "control1", "control2"],
          "properties": {
            "type": { "const": "cubic_bezier" },
            "control1": { "$ref": "#/$defs/point" },
            "control2": { "$ref": "#/$defs/point" }
          }
        }
      ]
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "direction", "max_speed_mps", "geometry"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" },
        "direction": { "enum": ["both", "forward"] },
        "max_speed_mps": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100 },
        "geometry": { "$ref": "#/$defs/geometry" }
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "x", "y", "s", "heading"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 }, "x": { "type": "number" }, "y": { "type": "number" },
        "s": { "type": "number", "minimum": 0 }, "heading": { "type": "number" }
      }
    },
    "trajectory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "edge_id", "direction", "max_speed_mps", "points", "length"],
      "properties": {
        "id": { "$ref": "#/$defs/trajectoryId" }, "edge_id": { "$ref": "#/$defs/id" },
        "direction": { "enum": ["forward", "reverse"] },
        "max_speed_mps": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100 },
        "points": { "type": "array", "minItems": 2, "maxItems": 10000, "items": { "$ref": "#/$defs/sample" } },
        "length": { "type": "number", "minimum": 0 }
      }
    }
  }
}
